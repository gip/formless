{
  "name": "formless-health",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "generate:starter": "node scripts/generate-starter-files.mjs",
    "generate:directory": "node scripts/fetch-epic-directory.mjs",
    "lint": "eslint . --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "typecheck:guest": "tsc --noEmit -p guest/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@webcontainer/api": "^1.6.4",
    "next": "16.3.4",
    "pg": "^8.13.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "22.19.19",
    "@types/pg": "^8.11.10",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.0.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.11"
  },
  "type": "module"
}
